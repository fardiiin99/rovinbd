# --- Admin login ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=use-a-strong-password
AUTH_SECRET=a-long-random-string-at-least-32-characters

# --- Postgres ---
# Supabase dashboard -> Project Settings -> Database -> Connection string.
# Self-hosting on Coolify means a long-running Node server rather than
# serverless functions, so the direct connection (port 5432) is fine and
# avoids the pooler's prepared-statement limits. The "Connection pooling"
# URI (Transaction mode, port 6543) also works if you prefer it.
# postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# If you run Postgres as its own Coolify resource, use that service's internal
# hostname, e.g. postgres://postgres:<password>@<service-name>:5432/postgres
POSTGRES_URL=
# DATABASE_URL is accepted as a fallback if POSTGRES_URL is unset. DB_PASSWORD
# is only needed in the rare case where the password can't be embedded in the
# URL (src/lib/pg.ts then passes it separately); leave both unset normally.

# --- Analytics: Google Analytics 4 ---
NEXT_PUBLIC_GA_ID=G-Y3XL9ENBXH

# --- Analytics: Meta (Facebook) Pixel + Conversions API ---
# NEXT_PUBLIC_META_PIXEL_ID: OPTIONAL. The production pixel ID is hardcoded in
# src/lib/pixel-config.ts (as the GA ID is in layout.tsx), so leaving this
# blank is fine and the pixel still fires. Set it only to point a build at a
# different pixel, e.g. a staging or test pixel.
# NEXT_PUBLIC_* is inlined at BUILD time, so in Coolify an override must be set
# as a BUILD variable (not runtime-only) and the app redeployed to take effect.
# An unparseable value is ignored in favour of the built-in ID, with a console
# warning. Check what a running deploy uses with GET /api/pixel/track.
NEXT_PUBLIC_META_PIXEL_ID=
# META_CAPI_ACCESS_TOKEN: Events Manager -> your pixel -> Settings ->
# Conversions API -> "Generate access token". Optional, but without it the
# server-side (Conversions API) mirror of each event is skipped, so iOS /
# ad-blocked traffic is lost and events aren't deduplicated server-side.
META_CAPI_ACCESS_TOKEN=
# META_CAPI_TEST_CODE: optional. Paste the TEST#### code from Events Manager ->
# Test Events while verifying, then remove it — it keeps events out of reporting.
META_CAPI_TEST_CODE=

# --- Image uploads ---
# Admin image uploads go to Supabase Storage (bucket: "images") when both vars
# below are set. If either is missing the route falls back to storing the bytes
# in Postgres (uploaded_images table) and serving them from /api/images/<id>,
# which works but bloats the database — prefer Supabase Storage in production.
# NEXT_PUBLIC_SUPABASE_URL is a NEXT_PUBLIC_* var: set it as a build variable too.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase dashboard -> Project Settings -> API -> service_role key.
# Server-side only — it bypasses row-level security, so never expose it to the
# browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_KEY=

# --- SMS (Alpha SMS) ---
# Required for order-confirmation SMS and admin broadcasts.
ALPHA_SMS_API_KEY=
# ALPHA_SMS_SENDER_ID: optional masking name e.g. "ROVIN" (needs Alpha SMS approval).
ALPHA_SMS_SENDER_ID=
# ADMIN_SMS_PHONE: optional. Gets an SMS copy of each new order.
ADMIN_SMS_PHONE=

# --- Pathao delivery (optional) ---
# All five are required together; if any is missing, order creation skips the
# Pathao consignment and the order is still saved.
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
# PATHAO_ENVIRONMENT: set to "sandbox" to hit Pathao's test API. Anything else
# (or unset) uses production.
PATHAO_ENVIRONMENT=

# --- Telegram order notifications (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- GA4 Measurement Protocol (optional) ---
# Server-side purchase tracking. GA4 admin -> Data Streams -> your stream ->
# Measurement Protocol API secrets. Used together with NEXT_PUBLIC_GA_ID.
GA4_API_SECRET=
