# --- Admin login ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=use-a-strong-password
AUTH_SECRET=a-long-random-string-at-least-32-characters

# --- Supabase Postgres ---
# Supabase dashboard -> Project Settings -> Database -> Connection string ->
# "Connection pooling" (Transaction mode, port 6543) is recommended for
# serverless/Vercel deployments. Paste it here, e.g.:
# postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
POSTGRES_URL=
NEXT_PUBLIC_GA_ID=G-Y3XL9ENBXH

# --- Meta (Facebook) Pixel + Conversions API ---
# NEXT_PUBLIC_META_PIXEL_ID: the numeric pixel ID from Events Manager
# (business.facebook.com/events_manager -> Data Sources -> your pixel).
# WITHOUT THIS THE PIXEL IS COMPLETELY DISABLED: the base code is not rendered
# and every PageView / ViewContent / AddToCart / InitiateCheckout / Purchase
# event silently no-ops. It is a NEXT_PUBLIC_* var, so it is inlined at BUILD
# time — after adding it in Vercel you must redeploy for it to take effect.
# Check what a running deploy actually has with GET /api/pixel/track.
NEXT_PUBLIC_META_PIXEL_ID=
# META_CAPI_ACCESS_TOKEN: Events Manager -> your pixel -> Settings ->
# Conversions API -> "Generate access token". Optional, but without it the
# server-side (Conversions API) mirror of each event is skipped, so iOS /
# ad-blocked traffic is lost and events aren't deduplicated server-side.
META_CAPI_ACCESS_TOKEN=
# META_CAPI_TEST_CODE: optional. Paste the TEST#### code from Events Manager ->
# Test Events while verifying, then remove it — it keeps events out of reporting.
META_CAPI_TEST_CODE=

# --- Image uploads (committed straight to GitHub) ---
# GITHUB_TOKEN: a GitHub Personal Access Token with "Contents: Read and write"
# permission on GITHUB_REPO. The admin upload route commits each uploaded
# image to public/uploads/ in this repo, which Vercel's Git integration then
# auto-deploys (~1-2 min lag per upload). Requires the Vercel project to be
# connected to this same repo under Project Settings -> Git.
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_BRANCH=main
